# Production settings for docker-compose.prod.yml. Copy to .env and fill in.
# DJANGO_DEBUG, the database host and the proxy settings are set by the
# compose file itself.

# Public hostname of this server; its DNS A record must point at the server's
# Elastic IP before the first start, or Caddy cannot get a certificate.
DOMAIN=api.example.com

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# The Flutter app is not a browser and needs no CORS; list web origins only.
DJANGO_CORS_ALLOWED_ORIGINS=

# Fixed when the MySQL volume is first created: openssl rand -base64 24
MYSQL_DATABASE=emotune
MYSQL_USER=emotune
MYSQL_PASSWORD=

JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# Gmail App Password (not the account password) for password-reset mail.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=EmoTune <you@gmail.com>

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Add this exact URI in the Spotify Developer Dashboard too.
SPOTIFY_REDIRECT_URI=https://api.example.com/api/spotify/callback/
SPOTIFY_APP_REMOTE_REDIRECT_URI=emotune://spotify-auth-callback
SPOTIFY_APP_RETURN_URI=emotune://spotify-connected
SPOTIFY_OAUTH_STATE_MAX_AGE_SECONDS=600
SPOTIFY_HTTP_TIMEOUT_SECONDS=8

# Leave empty unless the line has been verified as current.
CRISIS_HOTLINE_TEXT=

EMOTION_HIGH_CONFIDENCE_THRESHOLD=0.68
EMOTION_MEDIUM_CONFIDENCE_THRESHOLD=0.45
EMOTION_MIN_MARGIN_THRESHOLD=0.12
EMOTION_TOP_EMOTIONS_COUNT=2
ML_MODEL_PATH=
